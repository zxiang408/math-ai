{
  "name": "math-ai",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-29",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "MATH_AI_LEARNER_ID": "local-default",
    "SUPABASE_URL": "https://xntpbacnvnbzzvxezjol.supabase.co"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
